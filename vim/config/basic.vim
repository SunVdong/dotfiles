" ===== 基础设置 =====
set nocompatible

" 行号
set number

" 缩进
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent

" 搜索
set ignorecase
set smartcase
set incsearch
set hlsearch

" 显示
set cursorline
set showmatch

" 编码
set encoding=utf-8

" 关闭备份（避免产生垃圾文件）
set nobackup
set nowritebackup
set noswapfile